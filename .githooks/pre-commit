#!/usr/bin/env bash
# Runs before every commit. Activate once after cloning:
#   git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/tools/run-all.sh"

# Checks a contributor keeps for their own machine. tools/local/ is ignored,
# so the file never reaches the repository and is skipped when it is missing.
if [ -x "$root/tools/local/pre-commit" ]; then
  "$root/tools/local/pre-commit"
fi

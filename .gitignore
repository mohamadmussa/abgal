# Android SDK, fetched by abgal setup and abgal create, several gigabytes.
sdk/

# Virtual device images and their runtime state, several gigabytes.
avd/

# User files of the SDK tools, redirected here from ~/.android. Includes a
# copy of the private adb key, so this never reaches a commit.
android-home/

# Raw experiment output and run artifacts, local evidence only.
experiments/
runs/
results/

# Downloaded application packages.
apk/*
!apk/README.md

# The version of the app under test. That is a property of whoever tests,
# not of this project, so it stays on the machine that does the testing.
app.conf

# German working copies. The published language is English, except this one
# committed mirror.
*.de.md
!docs/architecture.de.md

# Local files and folders of any kind.
*.local.*
*.local/

# Logs. One folder per guest, plus the rotated generation, which the
# suffix rule below would miss because it ends in .1 and not in .log.
logs/
*.log

# The concrete words the commit gate refuses. Local only, by design:
# a published deny list would publish the very values it protects.
.private-words

# Tools fetched for this checkout, such as the pinned shellcheck the workflow
# also uses. They are binaries and they belong to the machine, but they stay
# under the project so that they are findable months later.
tools/local/

# Python bytecode.
__pycache__/
*.pyc

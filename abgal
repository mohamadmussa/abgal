HOME = Path(__file__).resolve().parent
SDK = HOME / "sdk"
AVD = HOME / "avd"
RUNNERS = HOME / "runners"
LOGS = HOME / "logs"
ANDROID_USER = HOME / "android-home"
ADB = SDK / "platform-tools" / "adb"
EMULATOR = SDK / "emulator" / "emulator"
AVDMANAGER = SDK / "cmdline-tools" / "latest" / "bin" / "avdmanager"
# The Android CLI replaces sdkmanager from command line tools 23.0 on. Only it
# takes --no-metrics, sdkmanager collects usage data on every call.
ANDROID_CLI = SDK / "cmdline-tools" / "latest" / "bin" / "android"

# The kernel truncates a process name to fifteen characters, and the binary
# is called qemu-system-x86_64. This is the name that actually appears.
QEMU = "qemu-system-x86"

# Where the kernel shows processes and memory. A constant so the tests can
# point it at a fake tree.
PROC = Path("/proc")

# Above the memory a guest is configured for. A guest keeps growing for
# minutes after it reports a completed boot, so only the settled figure counts.
# Almost all of it is the software renderer, which is the same size whatever
# the guest is given. Measured on 2026-09-23: four guests of 1536 MB held
# 9780 MB between them, and a single one settled at 2415 MB.
OVERHEAD_MB = 900

# How long an orderly shutdown may take before the signals start. Stop and
# delete share the number so that --force deletes the same way stop does.
GRACE_SECONDS = 20

# What the machine keeps for itself. A guest does not reach its full size at
# boot, it grows for minutes afterwards: measured on 2026-09-22, the same
# guest left 6875 MB free right after booting and 6106 MB a minute later.
# A check at start time is therefore always the friendliest number of the
# run, and without this reserve it would wave through a start that only
# turns out to be too much once nobody is watching.
RESERVE_MB = 1024

# How long the id of a guest is. Eight hex characters are four thousand
# million possibilities, far more than one machine will ever hold, and still
# short enough to type out by hand.
ID_CHARS = 8


# ---------------------------------------------------------------- foundation


def fail(message):
    print("ERROR: " + message, file=sys.stderr)
    sys.exit(1)


def problem(message):
    """Says what went wrong without ending the program.

    A batch keeps going after one guest has refused, so its reason is printed
    where it happened and counted at the end.
    """
    print("ERROR: " + message, file=sys.stderr)
    return 1


def sdk_env():
    """The environment every tool of the SDK is called in.

    The same values bin/env.sh exports for a shell. They are set here as well
    so that abgal works in a session where nothing was sourced.
    """
    env = dict(os.environ)
    env["ANDROID_HOME"] = str(SDK)
    env["ANDROID_SDK_ROOT"] = str(SDK)
    env["ANDROID_AVD_HOME"] = str(AVD)
    # avdmanager and the Android CLI read the first name. The emulator reads
    # only the second, and adb reads neither, keeping its key in ~/.android.
    env["ANDROID_USER_HOME"] = str(ANDROID_USER)
    env["ANDROID_EMULATOR_HOME"] = str(ANDROID_USER)
    env["PATH"] = os.pathsep.join(
        [str(SDK / "platform-tools"), str(SDK / "emulator"), env.get("PATH", "")]
    )
    return env


def adb(*args, serial=None, timeout=30):
    """Runs one adb command and returns exit code, output and error."""
    command = [str(ADB)]
    if serial:
        command += ["-s", serial]
    command += [str(a) for a in args]
    try:
        done = subprocess.run(
            command, capture_output=True, text=True, timeout=timeout, env=sdk_env()
        )
    except (subprocess.TimeoutExpired, OSError) as problem:
        return 1, "", str(problem)
    return done.returncode, done.stdout.strip(), done.stderr.strip()


INI_LINE = re.compile(r"^([A-Za-z0-9._]+)\s*=\s*(.*)$")


def read_ini(path):
    """Reads config.ini, in both of the spellings it comes in.

    avdmanager writes "key=value", the emulator rewrites the same line as
    "key = value" at every start. The first occurrence of a key wins, which
    is what the shell scripts do with head -1.
    """
    values = {}
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return values
    for line in text.splitlines():
        found = INI_LINE.match(line.strip())
        if found and found.group(1) not in values:
            values[found.group(1)] = found.group(2).strip()
    return values


def memory_mb(raw):
    """config.ini writes memory either as a plain number or with a suffix."""
    raw = (raw or "").strip()
    try:
        if raw.upper().endswith("G"):
            return int(float(raw[:-1]) * 1024)
        if raw.upper().endswith("M"):
            return int(float(raw[:-1]))
        return int(float(raw))
    except ValueError:
        return 0


def available_mb():
    """Free memory, read from the kernel and not from "free".

    The "free" command translates its row labels, so a pattern for "Mem:"
    silently matches nothing on a machine that is not set to English.
    """
    try:
        for line in (PROC / "meminfo").read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


# -------------------------------------------------------------------- guests


TEMPLATE_FIELDS = ("name", "device", "api", "tag", "abi", "ram", "cores", "note")


def template_rows():
    """Every line of devices.conf, as a dict of its eight columns."""
    found = []
    try:
        text = (HOME / "devices.conf").read_text()
    except OSError:
        return found
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = [f.strip() for f in line.split("|")]
        if len(fields) >= len(TEMPLATE_FIELDS):
            row = dict(zip(TEMPLATE_FIELDS, fields))
            row["image"] = "system-images;android-%s;%s;%s" % (
                row["api"], row["tag"], row["abi"])
            found.append(row)
    return found


def templates():
    """The templates in devices.conf, as name and note."""
    return [(row["name"], row["note"]) for row in template_rows()]


def guest_id(folder):
    """The id of this guest, given to it once and never changed again.

    The file is created with O_EXCL, so two processes that meet a guest
    without an id at the same moment cannot both give it one. The loser of
    that race reads what the winner wrote, on the second turn.
    """
    mark = folder / "abgal-id"
    for _ in range(2):
        try:
            found = mark.read_text(errors="replace").strip()
        except OSError:
            found = ""
        if found:
            return found
        try:
            handle = os.open(str(mark), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except OSError:
            continue
        with os.fdopen(handle, "w") as stream:
            stream.write(secrets.token_hex(ID_CHARS // 2) + "\n")
    return "unknown"


def guests():
    """Every guest on disk, with its template and its id."""
    found = []
    if not AVD.is_dir():
        return found
    for folder in sorted(AVD.glob("*.avd")):
        if not folder.is_dir():
            continue
        mark = folder / "abgal-template"
        template = "unknown"
        if mark.is_file():
            template = mark.read_text(errors="replace").strip() or "unknown"
        found.append((folder.name[:-4], template, guest_id(folder)))
    return found


def guest_folder(name):
    return AVD / (name + ".avd")


def resolve(wanted):
    """The name of the guest behind a name or an id.

    Both work wherever a guest has to be named. The id belongs to this one
    guest for its whole life, while a name is freed by a delete and can be
    handed to a different guest later.
    """
    rows = guests()
    for name, _, number in rows:
        if wanted in (name, number):
            return name
    known = ", ".join("%s (%s)" % (n, i) for n, _, i in rows)
    fail("there is no guest called '%s'.\n       On disk: %s"
         % (wanted, known or "nothing yet."))


def qemu_processes():
    """Every running emulator, as pid and its argument list."""
    for entry in PROC.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if (entry / "comm").read_text().strip() != QEMU:
                continue
            raw = (entry / "cmdline").read_bytes()
        except OSError:
            continue
        args = [a.decode(errors="replace") for a in raw.split(b"\0") if a]
        yield int(entry.name), args


def watch_processes():
    """Every running 'abgal watch' process, as pid and its argument list.

    start detaches the watch with start_new_session=True, so it has no
    parent-child link to anything abgal could wait on. This is the same
    /proc scan qemu_processes runs, pointed at the watch subcommand instead.
    """
    script = str(Path(__file__).resolve())
    for entry in PROC.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            raw = (entry / "cmdline").read_bytes()
        except OSError:
            continue
        args = [a.decode(errors="replace") for a in raw.split(b"\0") if a]
        if script in args and "watch" in args:
            yield int(entry.name), args


def running_pid(name):
    """The pid this guest runs under, or None.

    The name is compared against whole arguments. A search through the joined
    command line would also match a guest whose name merely starts the same.
    """
    for pid, args in qemu_processes():
        if name in args:
            return pid
    return None


def process_stats(pid):
    """RSS in MB, CPU percent and age in seconds for one running process, or None.

    cpu_percent is the process's whole CPU time divided by its wall clock
    age, the average since it started, the same figure "ps -o %cpu" shows
    by default. A true instantaneous value needs two /proc reads a fixed
    interval apart, either blocking this call or a background sampling
    thread, more than a status readout is worth.
    """
    try:
        status = (PROC / str(pid) / "status").read_text()
        stat = (PROC / str(pid) / "stat").read_text()
        uptime = float((PROC / "uptime").read_text().split()[0])

        mem_kb = 0
        for line in status.splitlines():
            if line.startswith("VmRSS:"):
                mem_kb = int(line.split()[1])
                break

        # Field 2, the command in parentheses, can itself contain spaces or
        # parentheses, so the split resumes after its closing ")" rather
        # than trusting a fixed field count.
        fields = stat[stat.rfind(")") + 2:].split()
        utime, stime, starttime = int(fields[11]), int(fields[12]), int(fields[19])
    except (OSError, ValueError, IndexError):
        return None

    clk_tck = os.sysconf("SC_CLK_TCK")
    age = uptime - starttime / clk_tck
    if age <= 0:
        return {"mem_mb": mem_kb // 1024, "cpu_percent": 0.0, "uptime_s": 0}
    cpu_percent = 100 * (utime + stime) / clk_tck / age
    return {"mem_mb": mem_kb // 1024, "cpu_percent": round(cpu_percent, 1), "uptime_s": int(age)}


def format_uptime(seconds):
    """Seconds as DD:HH:MM, the shape the status table shows."""
    minutes = seconds // 60
    days, minutes = divmod(minutes, 24 * 60)
    hours, minutes = divmod(minutes, 60)
    return "%02d:%02d:%02d" % (days, hours, minutes)


# ----------------------------------------------------------------------- adb


def attached():
    """Every emulator adb knows, as serial mapped to its state.

    The state matters and is passed on unchanged. "device" is ready, "offline"
    is still booting or already dying, and "unauthorized" means the console
    token was not accepted. All three look like a running guest from outside.
    """
    adb("start-server", timeout=60)
    code, out, _ = adb("devices")
    found = {}
    if code != 0:
        return found
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and parts[0].startswith("emulator-"):
            found[parts[0]] = parts[1]
    return found


def serial_name(serial):
    """Asks the emulator itself which guest it is running.

    Without -port the emulator picks its own port, so the port cannot be read
    from the command line that started it. The console knows the answer, and
    it answers long before the guest has finished booting.
    """
    code, out, _ = adb("emu", "avd", "name", serial=serial, timeout=10)
    if code != 0 or not out:
        return None
    first = out.splitlines()[0].strip()
    return None if first in ("", "OK", "KO") else first


def serial_of(name):
    """The serial this guest is reachable under, or None."""
    for serial, state in attached().items():
        if state == "unauthorized":
            continue
        if serial_name(serial) == name:
            return serial
    return None


def port_of(serial):
    try:
        return int(serial.split("-")[1])
    except (IndexError, ValueError):
        return 0


# -------------------------------------------------------------------- output


def field(label, value):
    print("  %-10s %s" % (label, value))


def run_tool(command, answer="", quiet=False):
    """Runs avdmanager or the Android CLI and answers questions on stdin.

    The answers are written from here instead of piped from "yes". A tool
    that stops reading early then only closes a pipe, where "yes | tool"
    under pipefail ended with 141 although the tool had succeeded.
    """
    # The tool writes to the same terminal without our buffer in between, so
    # anything still held back here would appear after it.
    sys.stdout.flush()
    done = subprocess.run(
        [str(c) for c in command], input=answer, text=True, env=sdk_env(),
        stdout=subprocess.DEVNULL if quiet else None,
    )
    return done.returncode


# -------------------------------------------------------------------- create


GUEST_NAME = re.compile(r"^[A-Za-z0-9._-]+$")

# avdmanager writes "key=value", the emulator rewrites the same line as
# "key = value" at every start. Measured on 2026-09-20: 139 of 144 lines after
# one start. Everything is brought back to the first spelling before a compare.
CONFIG_LINE = re.compile(r"^([A-Za-z0-9._]+)\s*=\s*")

DENSITIES = {"ldpi": "120", "mdpi": "160", "tvdpi": "213", "hdpi": "240",
             "xhdpi": "320", "xxhdpi": "480", "xxxhdpi": "640"}


def link_devices_xml():
    """Puts devices.xml where avdmanager reads screens from.

    A link keeps one source. A file that is already there, for example from
    Android Studio, is left alone.
    """
    target = ANDROID_USER / "devices.xml"
    if target.exists():
        return
    if target.is_symlink():
        target.unlink()
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(HOME / "devices.xml")
    print("Device description linked: android-home/devices.xml -> %s"
          % (HOME / "devices.xml"))


def device_listed(device):
    done = subprocess.run([str(AVDMANAGER), "list", "device"],
                          capture_output=True, text=True, env=sdk_env())
    if done.returncode != 0:
        problem("avdmanager list device failed, exit %d:\n%s" %
                (done.returncode, (done.stderr + done.stdout).strip()))
    return '"%s"' % device in done.stdout


def device_value(device, name):
    """One value from the block of this device in devices.xml."""
    try:
        text = (HOME / "devices.xml").read_text()
    except OSError:
        return ""
    start = text.find("<d:id>%s</d:id>" % device)
    if start < 0:
        return ""
    end = text.find("</d:device>", start)
    found = re.search(r"<d:%s>([^<]*)" % re.escape(name),
                      text[start:end if end > 0 else None])
    return found.group(1).strip() if found else ""


def density_number(raw):
    """xxhdpi and its relatives as the number config.ini carries."""
    if raw in DENSITIES:
        return DENSITIES[raw]
    return raw[:-3] if raw.endswith("dpi") else raw


def config_lines(path):
    return [CONFIG_LINE.sub(r"\1=", line) for line in path.read_text().splitlines()]


def set_value(lines, key, value):
    prefix = key + "="
    old = next((line[len(prefix):] for line in lines if line.startswith(prefix)), None)
    if old == value:
        return
    if old is None:
        lines.append(prefix + value)
        old = "missing"
    else:
        lines[:] = [prefix + value if line.startswith(prefix) else line
                    for line in lines]
    print("  %s: %s -> %s" % (key, old, value))


def verify(config, row, guest):
    """Reads config.ini back and compares thirteen values with the template.

    Without this a run only says the tools ran, not that they did what was
    asked. Exactly that swallowed three values on the first attempt.
    """
    # Screen and density come from devices.xml and not from a literal, or a
    # tablet would later be checked against the values of the phone.
    store = "yes" if row["tag"] == "google_apis_playstore" else "no"
    expected = [
        "abi.type=" + row["abi"],
        "PlayStore.enabled=" + store,
        "firstboot.bootFromDownloadableSnapshot=no",
        "firstboot.bootFromLocalSnapshot=no",
        "firstboot.saveToLocalSnapshot=no",
        "hw.camera.front=emulated",
        "hw.device.name=" + row["device"],
        "hw.lcd.density=" + density_number(device_value(row["device"], "pixel-density")),
        "hw.lcd.height=" + device_value(row["device"], "y-dimension"),
        "hw.lcd.width=" + device_value(row["device"], "x-dimension"),
        "hw.cpu.ncore=" + row["cores"],
        "hw.ramSize=" + row["ram"],
        "image.sysdir.1=system-images/android-%s/%s/%s/" % (row["api"], row["tag"], row["abi"]),
        "tag.id=" + row["tag"],
    ]
    lines = config_lines(config)
    errors = 0
    print()
    print("Verifying against config.ini:")
    for line in expected:
        if line in lines:
            print("  ok      " + line)
            continue
        key = line.split("=", 1)[0] + "="
        found = next((l for l in lines if l.startswith(key)), "")
        print("  MISSING %s   (found: %s)" % (line, found or "nothing"))
        errors += 1
    print()
    if errors:
        print("%d values do not match. %s is not the guest we wanted." % (errors, guest))
        return False
    print("All values match. %s is at %s" % (guest, guest_folder(guest)))
    print()
    return True


def fetch_system_image(image, images):
    """Downloads a system image, retrying a transient connection drop.

    Measured on 2026-09-29: a hosted CI runner's download failed once with
    "Peer disconnected" and succeeded on the next attempt, nothing about the
    image or the runner was actually wrong. The CLI ends with 0 even for a
    package it does not know, so only the folder counts.
    """
    command = [ANDROID_CLI, "--no-metrics", "--sdk=%s" % SDK,
               "sdk", "install", image]
    attempts = 3
    for attempt in range(attempts):
        if run_tool(command, quiet=True) == 0 and images.is_dir():
            return True
        if attempt < attempts - 1:
            print("Fetch failed, trying again (attempt %d of %d)." %
                  (attempt + 2, attempts))
            time.sleep(5)
    return False


def create_one(row, guest, recreate):
    """Creates one guest and pins the values avdmanager drops or overrides.

    Measured on 2026-09-20: avdmanager silently dropped three values of the
    device description and set three more so that a run was not repeatable.
    """
    # avdmanager accepts a name it cannot find again later, because the name
    # also becomes a folder.
    if not GUEST_NAME.match(guest):
        problem("'%s' is not a usable guest name.\n"
                "       Letters, digits, dot, underscore and dash only." % guest)
        return False

    print("=" * 63)
    for label, value in (("Guest", guest), ("Template", row["name"]),
                         ("Device", row["device"]), ("Image", row["image"]),
                         ("Memory", row["ram"] + " MB"), ("Cores", row["cores"])):
        print("%-10s%s" % (label, value))
    print("=" * 63)

    if not device_listed(row["device"]):
        problem("device %s is not listed in devices.xml." % row["device"])
        return False

    images = SDK / "system-images" / ("android-" + row["api"]) / row["tag"] / row["abi"]
    if not images.is_dir():
        print("The system image is missing. Fetching it, which takes a few minutes:")
        print('  android --no-metrics sdk install "%s"' % row["image"])
        if not fetch_system_image(row["image"], images):
            problem("the Android CLI did not fetch %s." % row["image"])
            return False

    # A running emulator rewrites config.ini at start, so whatever is written
    # now would be gone by the next start at the latest.
    if running_pid(guest):
        problem("%s is running right now. Stop it first, or the change will be lost."
                % guest)
        return False

    folder = guest_folder(guest)
    config = folder / "config.ini"
    if recreate and folder.is_dir():
        print("Deleting existing guest %s" % guest)
        if run_tool([AVDMANAGER, "delete", "avd", "-n", guest], quiet=True) != 0:
            problem("avdmanager did not delete %s." % guest)
            return False

    if folder.is_dir():
        print("%s already exists, only updating the values" % guest)
    else:
        # Measured on 2026-09-24: when ANDROID_AVD_HOME does not exist yet,
        # avdmanager writes to android-home/avd without a word.
        AVD.mkdir(parents=True, exist_ok=True)
        command = [AVDMANAGER, "create", "avd", "-n", guest,
                   "-k", row["image"], "-d", row["device"]]
        if run_tool(command, answer="no\n") != 0:
            problem("avdmanager could not create %s." % guest)
            return False
    if not config.is_file():
        stray = ANDROID_USER / "avd" / (guest + ".avd")
        problem("avdmanager reported success, but %s is missing.%s" % (config, (
            "\n       It landed in %s instead, so avdmanager did not"
            "\n       use ANDROID_AVD_HOME=%s." % (stray, AVD)) if stray.is_dir() else ""))
        return False

    # config.ini is rewritten by the emulator at every start, so an extra key
    # there would not survive. A file of its own does.
    (folder / "abgal-template").write_text(row["name"] + "\n")

    # Value                                   created  set       reason
    # PlayStore.enabled                       no       yes       only the store template
    # hw.ramSize                              2G       from conf devices.xml is overridden here
    # hw.cpu.ncore                            varies   from conf devices.xml is overridden here
    # hw.camera.front                         none     emulated  devices.xml describes one
    # firstboot.bootFromDownloadableSnapshot  yes      no        would fetch state from the network
    # firstboot.bootFromLocalSnapshot         yes      no        a run must not depend on the last
    # firstboot.saveToLocalSnapshot           yes      no        the same in the other direction
    lines = config_lines(config)
    print("Updating the values:")
    if row["tag"] == "google_apis_playstore":
        set_value(lines, "PlayStore.enabled", "yes")
    set_value(lines, "hw.ramSize", row["ram"])
    set_value(lines, "hw.cpu.ncore", row["cores"])
    set_value(lines, "hw.camera.front", "emulated")
    set_value(lines, "firstboot.bootFromDownloadableSnapshot", "no")
    set_value(lines, "firstboot.bootFromLocalSnapshot", "no")
    set_value(lines, "firstboot.saveToLocalSnapshot", "no")
    config.write_text("\n".join(lines) + "\n")

    return verify(config, row, guest)


# ------------------------------------------------------------------ commands


def cmd_list(args):
    print("Templates in devices.conf:")
    rows = templates()
    if not rows:
        print("  none. devices.conf is missing or empty.")
    for name, note in rows:
        print("  %-40s %s" % (name, note))

    print()
    print("Guests on disk:")
    rows = guests()
    if not rows:
        print("  none yet. Create one with: abgal create <template>")
        return 0
    for name, template, number in rows:
        print("  %-24s %-9s from %s" % (name, number, template))
    return 0


def confirm_recreate(existing):
    """Asks once before --recreate deletes guests already on disk."""
    if not sys.stdin.isatty():
        fail("nothing to ask on. Pass --yes to delete %s unattended."
             % ", ".join(existing))
    try:
        answer = input("Delete %s and its disk? This cannot be undone. [y/N] "
                        % ", ".join(existing))
    except EOFError:
        print()
        answer = ""
    return answer.strip().lower() in ("y", "yes")


def cmd_create(args):
    if args.yes and not args.recreate:
        fail("--yes only applies to --recreate.")

    # Without a template this shows what there is to choose from. The names
    # are long on purpose, so being asked to type one from memory is the
    # wrong way round: the program knows them and says them.
    if not args.template:
        args.parser.print_help()
        print()
        cmd_list(args)
        # Nothing was created, so the exit code has to say so. A script that
        # calls this with an empty variable must not read it as success.
        return 1

    known = [t for t, _ in templates()]
    if args.template not in known:
        fail(
            "the template '%s' is not in devices.conf.\n       Known: %s"
            % (args.template, ", ".join(known) if known else "none")
        )
    if args.count < 1:
        fail("--count has to be at least 1.")
    if not AVDMANAGER.is_file() or not ANDROID_CLI.is_file():
        fail("avdmanager or android is not under %s.\n"
             "       The command line tools 23.0 or newer belong in"
             " sdk/cmdline-tools/latest.\n"
             "       Run ./abgal doctor to see what is missing." % AVDMANAGER.parent)

    base = args.after or args.template
    if args.count == 1:
        names = [base]
    else:
        # Zero padded so that a plain sort puts guest 2 before guest 10. Two
        # digits are enough for the sixteen ports adb offers, and the width
        # grows by itself if somebody asks for more.
        width = max(2, len(str(args.count)))
        names = ["%s-%0*d" % (base, width, n) for n in range(1, args.count + 1)]

    if args.recreate:
        # One question covers the whole batch, so a --count run does not
        # ask sixteen times over.
        existing = [n for n in names if guest_folder(n).is_dir()]
        # Recreating a running guest loses whatever it holds, so this is a
        # refusal and not something --yes or a prompt can wave through.
        running = [n for n in existing if running_pid(n)]
        if running:
            fail("still running: %s. Stop first, for example: abgal stop -n %s"
                 % (", ".join(running), running[0]))
        if existing and not args.yes and not confirm_recreate(existing):
            print("Nothing was deleted.")
            return 1

    row = next(r for r in template_rows() if r["name"] == args.template)
    link_devices_xml()
    failed = []
    for number, name in enumerate(names, 1):
        if len(names) > 1:
            print("[%d of %d]" % (number, len(names)))
        if not create_one(row, name, args.recreate):
            failed.append(name)

    if failed:
        fail("%d of %d guests were not created: %s"
             % (len(failed), len(names), ", ".join(failed)))

    # The id is handed out on the first read, so this line is the moment it
    # comes into being. Showing it here saves a look at the list afterwards.
    print()
    print("Created %d from %s:" % (len(names), args.template))
    for name in names:
        print("  %-24s %s" % (name, guest_id(guest_folder(name))))
    print()
    print("Start it with: abgal start -n %s" % names[0])
    return 0


def cmd_delete(args):
    name = resolve(args.name)
    pid = running_pid(name)
    if pid:
        # --yes only answers the question, it does not overrule a running
        # guest. Deleting the disk out from under a live qemu is how an
        # unattended script turns a typo into a corrupted image.
        if not args.force:
            fail("%s is running as pid %d. Stop it first, or pass --force."
                 % (name, pid))
        print("%s is running. --force stops it before deleting." % name)
        if not stop_one(name, running_serials().get(name), args.grace):
            fail("%s could not be stopped, so nothing was deleted." % name)

    if not args.yes:
        if not sys.stdin.isatty():
            fail("nothing to ask on. Pass --yes to delete %s unattended." % name)
        answer = input("Delete %s and its disk? This cannot be undone. [y/N] " % name)
        if answer.strip().lower() not in ("y", "yes"):
            print("Nothing was deleted.")
            return 1

    # Quiet, because avdmanager ends its line without a newline and the
    # sentence below says the same. Its errors still reach stderr.
    if run_tool([AVDMANAGER, "delete", "avd", "-n", name], quiet=True) != 0 \
            or guest_folder(name).exists():
        fail("avdmanager did not remove %s." % name)

    # The logs stay. They are the record of what this guest did, they cost
    # almost nothing, and a guest of the same name later starts a fresh file
    # and keeps the previous one as .1 anyway.
    print("%s is gone. Its folder under logs/ was left in place." % name)
    return 0


def wait_for_console(name, seconds):
    """Waits until the started guest answers on its console.

    This is the point at which a start has demonstrably worked. The emulator
    refuses a second instance of the same guest, but only after it is under
    way, and until then it looks exactly like a slow start.
    """
    started = time.time()
    while time.time() - started < seconds:
        serial = serial_of(name)
        if serial:
            return serial
        # A guest that has no process left after the first few seconds is not
        # slow, it is gone. Waiting the full timeout for it would only delay
        # the log that says why.
        if time.time() - started > 15 and running_pid(name) is None:
            return None
        time.sleep(2)
    return None


def wait_for_boot(serial, seconds):
    """Waits for sys.boot_completed, tolerating the restart -change-locale causes.

    -change-locale cold boots once and restarts the framework to apply, so
    boot_completed can read 1 briefly, drop back to 0 for the restart, and
    only then read 1 for good. One reading of 1 is therefore not enough,
    two in a row are required before the guest counts as up.
    """
    deadline = time.time() + seconds
    seen_once = False
    while time.time() < deadline:
        code, out, _ = adb("shell", "getprop", "sys.boot_completed", serial=serial)
        if code == 0 and out.strip() == "1":
            if seen_once:
                return True
            seen_once = True
        else:
            seen_once = False
        time.sleep(3)
    return False


def start_one(args, name):
    # Printed first, so a batch reads as one block per guest instead of all
    # the checks running together before any name is said. A real start only
    # says so once the checks below have passed, so a refusal never follows
    # a line that already claimed the guest was starting.
    if args.dry_run:
        print("Would start %s" % name)

    would_refuse = False
    pid = running_pid(name)
    if pid:
        # A dry run reports what a real start would refuse on and keeps going,
        # instead of stopping at the first one.
        if args.dry_run:
            field("Check", "already running as pid %d, start would refuse" % pid)
            would_refuse = True
        else:
            return problem("%s is already running as pid %d." % (name, pid))

    # Read for this guest and at this moment. In a batch the guest before it
    # is already up and still growing, so every start gets the number that is
    # true for it and not the one the first guest saw.
    config = read_ini(guest_folder(name) / "config.ini")
    mark = guest_folder(name) / "abgal-template"
    template_name = mark.read_text().strip() if mark.is_file() else None
    wanted = memory_mb(config.get("hw.ramSize")) + OVERHEAD_MB
    free = available_mb()
    if args.dry_run and free is not None:
        # A dry run starts nothing, so the reading never drops as the batch
        # goes on. This charges it for the guests before it that would.
        free -= args.dry_run_committed
    if free is None:
        # No MemAvailable means no number to compare against, not that
        # memory is fine. --force already skips the check, so it skips the note too.
        if args.dry_run:
            field("Check", "MemAvailable unreadable, check skipped")
        elif not args.force:
            print("Note: MemAvailable is not in /proc/meminfo, so the memory check was skipped.")
    elif free < wanted + RESERVE_MB:
        if args.dry_run:
            field("Check", "needs about %d MB, %d MB free, %d MB reserved: "
                            "start would refuse without --force" % (wanted, free, RESERVE_MB))
            would_refuse = True
        elif not args.force:
            return problem(
                "%s needs about %d MB, %d MB are free, and %d MB stay reserved for\n"
                "       the machine. Stop a guest first, or insist with --force."
                % (name, wanted, free, RESERVE_MB)
            )
    elif args.dry_run:
        field("Check", "needs about %d MB, %d MB free, %d MB reserved: fits"
                        % (wanted, free, RESERVE_MB))

    if args.dry_run and not would_refuse:
        # This guest would really start, so the next one's check has to see
        # less free memory, the same way a real batch would.
        args.dry_run_committed += wanted

    # Guests created before the memory change still carry the old hw.ramSize,
    # and -lowram makes that stored value win over what the template says now.
    if template_name and config.get("hw.ramSize") is not None:
        row = next((r for r in template_rows() if r["name"] == template_name), None)
        if row and memory_mb(config.get("hw.ramSize")) != int(row["ram"]):
            stored = memory_mb(config.get("hw.ramSize"))
            print("Note: %s has %d MB in its config.ini, its template\n"
                  "      %s says %s MB." % (name, stored, template_name, row["ram"]))
            print("      It starts with %d MB. To bring it in line, keeping its disk:" % stored)
            print("      abgal create %s --as %s" % (template_name, name))

    command = [str(EMULATOR), "-avd", name]
    if args.port is not None:
        command += ["-port", str(args.port)]
    command += [
        "-no-window",
        "-no-audio",
        "-no-boot-anim",
        "-no-metrics",
        "-gpu", args.gpu,
        # Without this the emulator ignores hw.ramSize and raises every guest to
        # 2560 MB. With it the value is honoured exactly, and ro.config.low_ram
        # still comes back empty, so the guest is not a low memory device.
        "-lowram",
        "-no-snapshot-load",
        "-no-snapshot-save",
        # Measured on 2026-09-30: -prop persist.sys.locale and
        # persist.sys.timezone are both rejected, "only 'qemu.*' properties
        # are supported", and the guest silently keeps the image's own
        # locale. -change-locale and -timezone are the flags the emulator
        # itself documents for this. -change-locale cold boots once and
        # restarts the framework to apply, which is why wait_for_boot below
        # has to tolerate a boot_completed flag that goes back to 0.
        "-change-locale", args.locale,
        "-timezone", args.timezone,
    ]
    if args.wipe:
        command += ["-wipe-data"]

    # The kvm group can be in the group database without being in a session
    # that logged in before it was granted. "sg kvm" bridges that gap, but
    # only when direct access is actually missing, a hosted runner can widen
    # /dev/kvm itself and make the bridge unnecessary and, without a
    # terminal to answer its password prompt, broken.
    if not os.access(Path("/dev/kvm"), os.R_OK | os.W_OK):
        try:
            in_kvm = grp.getgrnam("kvm").gr_gid in os.getgroups()
        except KeyError:
            in_kvm = True
        if not in_kvm:
            print("Note: this session does not know the kvm group, starting via sg kvm.")
            command = ["sg", "kvm", "-c", " ".join(shlex.quote(c) for c in command)]

    folder = LOGS / name
    logfile = folder / "emulator.log"

    field("Template", template_name or "unknown")
    field("Screen", "%sx%s at %s dpi" % (config.get("hw.lcd.width", "?"),
                                         config.get("hw.lcd.height", "?"),
                                         config.get("hw.lcd.density", "?")))
    field("Memory", "%s MB" % config.get("hw.ramSize", "?"))
    field("Cores", config.get("hw.cpu.ncore", "?"))
    field("Graphics", args.gpu)
    field("Language", args.locale)
    field("Port", args.port if args.port is not None else "chosen by the emulator")
    field("Log", logfile)
    print()

    if args.dry_run:
        # Nothing on disk changes for a dry run, so the folder is never made
        # and the command is only shown, not handed to Popen.
        print("Command:")
        print("  " + " ".join(shlex.quote(c) for c in command))
        return 1 if would_refuse else 0

    print("Starting %s" % name)

    folder.mkdir(parents=True, exist_ok=True)

    # The previous run is kept as .1, the same two generations the watch keeps.
    # The failure message below quotes the last lines of this file, so it has
    # to hold this start and not the one before it.
    if logfile.exists():
        logfile.replace(folder / "emulator.log.1")

    with open(logfile, "wb") as stream:
        subprocess.Popen(
            command, stdout=stream, stderr=subprocess.STDOUT,
            cwd=str(HOME), env=sdk_env(), start_new_session=True,
        )

    serial = wait_for_console(name, args.timeout)
    if not serial:
        tail = ""
        try:
            tail = "\n".join(logfile.read_text(errors="replace").splitlines()[-8:])
        except OSError:
            pass
        return problem("%s did not come up. Last lines of the log:\n%s" % (name, tail))

    print("Console answers on %s." % serial)

    # The watch is started here and not before the emulator, because a start
    # the emulator then refuses would otherwise leave the watch behind. Two
    # watches for one guest write into the same log and rotate each other's
    # file away. Measured on 2026-09-22.
    if not args.no_watch:
        watch = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "watch", "-n", name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            cwd=str(HOME), env=sdk_env(), start_new_session=True,
        )
        watch_log = Path(os.environ.get("ABGAL_TEMP_LOG") or folder / "watch.log")
        # Its output goes nowhere, so being alive is the only sign it works. A
        # watch with nothing to measure ends within a second.
        time.sleep(WATCH_SETTLE)
        if watch.poll() is not None:
            problem("the temperature watch for %s ended at once with exit code %d.\n"
                    "       %s runs without it. See %s,\n"
                    "       and stop the guest with: abgal stop -n %s"
                    % (name, watch.returncode, name, watch_log, name))
            return WATCH_DIED
        print("Temperature watch running. Log: %s" % watch_log)

    if args.no_wait:
        return 0

    print("Waiting for the guest to finish booting.")
    if not wait_for_boot(serial, args.timeout):
        return problem("%s is running on %s but did not report a completed boot "
                       "in %d s." % (name, serial, args.timeout))
    print("%s is ready on %s." % (name, serial))
    return 0


def check_watch_temperature(dry_run):
    """True if the watch would refuse to start, for start's own dry run report."""
    watch_settings()
    temp = temperature(thermal_zone())
    if temp is not None:
        if dry_run:
            field("Watch", "%s C, the watch could run" % temp)
        return False

    # A dry run reports the refusal instead of making it, the same way
    # start_one does for its own checks.
    if not dry_run:
        fail("no processor temperature measurable, so no guest could be watched.\n"
             "       Neither the x86_pkg_temp zone nor sensors gave a value.\n"
             "       Start with --no-watch to run without the watch.")
    field("Watch", "no temperature measurable, start would refuse")
    return True


def cmd_start(args):
    # Without a name this prints the help instead of starting everything.
    # For create and status "all of them" is harmless, for start it is not:
    # thirty guests at once would take the machine down, and a command that
    # can do that should have to be spelled out, guest by guest.
    if not args.name:
        args.parser.print_help()
        print()
        cmd_list(args)
        # Nothing was started, so the exit code has to say so. "abgal start -n
        # $GUEST" with an unset variable must not report success.
        return 1

    names = [resolve(n) for n in args.name]

    if args.port is not None:
        # The emulator's own rule, from "emulator -help-port": an even number
        # from 5554 to 5584, because the next one up is taken by adb. Outside
        # that range adb no longer finds the guest by itself.
        if args.port < 5554 or args.port > 5584 or args.port % 2:
            fail("%d is not usable. Even numbers from 5554 to 5584 only." % args.port)
        if len(names) > 1:
            fail("--port names one port and %d guests were given. Start them in\n"
                 "       separate calls, or let the emulator pick." % len(names))

    # Before any guest runs, so a bad value stops the start and not the watch.
    # A watch that cannot measure may take sensors' full ten seconds to die,
    # long after start said it runs, so the reading is taken here as well.
    watch_refuses = False if args.no_watch else check_watch_temperature(args.dry_run)

    # A dry run starts nothing, so this is the running total of what the
    # guests already checked in this batch would have used, for start_one.
    args.dry_run_committed = 0

    # One after another, never at the same time. Each guest is given the whole
    # sequence of its own start, including its own memory check, and the one
    # after it only begins once that has come to an end.
    failed, unwatched, skipped = [], None, []
    for number, name in enumerate(names, 1):
        if len(names) > 1:
            print("[%d of %d]" % (number, len(names)))
        result = start_one(args, name)
        if len(names) > 1:
            print()
        # The next watch would most likely die the same way, so the batch
        # ends here instead of starting more guests without one.
        if result == WATCH_DIED:
            unwatched, skipped = name, names[number:]
            break
        if result != 0:
            failed.append(name)

    if failed:
        problem("%d of %d guests %s: %s"
                % (len(failed), len(names),
                   "would not start" if args.dry_run else "did not start",
                   ", ".join(failed)))
    if unwatched and len(names) > 1:
        problem("%s runs without a temperature watch.%s"
                % (unwatched, " Not started after it: %s" % ", ".join(skipped)
                   if skipped else ""))
    return 1 if failed or unwatched or watch_refuses else 0


def stop_one(name, serial, grace, say=print):
    """The orderly way first, force only afterwards.

    A hard kill can damage the device image, and rebuilding that costs more
    than the wait. The temperature watch stops a guest the same way.
    """
    if serial:
        say("  %s: asking %s to shut down." % (name, serial))
        adb("emu", "kill", serial=serial, timeout=20)

    deadline = time.time() + grace
    while time.time() < deadline:
        if running_pid(name) is None:
            say("  %s: stopped." % name)
            return True
        time.sleep(1)

    for step, number in (("SIGTERM", signal.SIGTERM), ("SIGKILL", signal.SIGKILL)):
        pid = running_pid(name)
        if pid is None:
            say("  %s: stopped." % name)
            return True
        say("  %s: not responding, %s to pid %d." % (name, step, pid))
        try:
            os.kill(pid, number)
        except OSError:
            pass
        time.sleep(10)

    if running_pid(name) is None:
        say("  %s: stopped." % name)
        return True
    say("  %s: still running. Nothing else this program can do." % name)
    return False


def running_serials():
    """Maps guest name to adb serial for every guest attached right now."""
    found = {}
    for serial, state in attached().items():
        if state == "unauthorized":
            # The serial answers but the console refused the token, so the
            # guest behind it cannot be asked for its name.
            continue
        name = serial_name(serial)
        if name:
            found[name] = serial
    return found


def cmd_stop(args):
    # Without a name this prints the help instead of stopping everything, the
    # same rule start follows. A stop that takes down thirty guests because a
    # flag was forgotten is the one mistake this program must not make easy.
    if not args.name:
        args.parser.print_help()
        print()
        live = [g for g, _, _ in guests() if running_pid(g) is not None]
        if live:
            print("Running right now: %s" % ", ".join(live))
        else:
            print("Nothing is running.")
        return 1

    targets = [resolve(n) for n in args.name]
    names = running_serials()

    print("Stopping %d guest(s):" % len(targets))
    # Every target is tried, and only then is the result judged. A short
    # circuit here would leave the guests after the first stubborn one running.
    results = [stop_one(name, names.get(name), args.grace) for name in targets]

    # The number worth having after a stop is how much room came back, because
    # that is what decides whether the next guest may start.
    free = available_mb()
    done = sum(1 for result in results if result)
    if free is None:
        print("%d of %d stopped." % (done, len(targets)))
    else:
        print("%d of %d stopped. Memory available: %d MB." % (done, len(targets), free))
    return 0 if all(results) else 1


def confirm_delete_all(names):
    """A typed arithmetic answer, fresh every call.

    Enter, yes or y answers nothing here on purpose, --DELETE takes down every
    guest and its disk at once, a single stray keystroke must not be enough.
    """
    a, b = secrets.randbelow(41) + 10, secrets.randbelow(41) + 10
    if not sys.stdin.isatty():
        fail("nothing to ask on. --DELETE needs a terminal to confirm.")
    try:
        answer = input(
            "--DELETE removes %d guest(s) and their disks for good: %s.\n"
            "This cannot be undone. What is %d + %d? " % (len(names), ", ".join(names), a, b)
        )
    except EOFError:
        print()
        answer = ""
    return answer.strip() == str(a + b)


def signal_watches(pending, number):
    for pid in pending:
        try:
            os.kill(pid, number)
        except OSError:
            pass


def surviving_watches(pending):
    return {pid for pid in pending if (PROC / str(pid)).exists()}


def wait_for_watches(pending, grace):
    deadline = time.time() + grace
    while pending and time.time() < deadline:
        pending = surviving_watches(pending)
        if pending:
            time.sleep(1)
    return surviving_watches(pending)


def stop_watches(grace, say=print):
    """Ends every detached 'abgal watch' process still running.

    A watch left alive after its guest is already gone would otherwise only
    notice on its next poll, up to ABGAL_TEMP_INTERVAL seconds later. The
    orderly signal first, the hard one only if that grace runs out, the same
    escalation stop_one gives a guest.
    """
    pending = {pid for pid, _ in watch_processes()}
    if not pending:
        return True
    say("Stopping %d temperature watch(es)." % len(pending))

    for number in (signal.SIGTERM, signal.SIGKILL):
        signal_watches(pending, number)
        pending = wait_for_watches(pending, grace)
        if not pending:
            return True

    say("%d temperature watch(es) still running. Nothing else this program can do."
        % len(pending))
    return False


def cmd_shutdown(args):
    live = [g for g, _, _ in guests() if running_pid(g) is not None]
    if not live:
        print("Nothing is running.")
    else:
        print("Stopping %d guest(s):" % len(live))
        serials = running_serials()
        results = [stop_one(name, serials.get(name), args.grace) for name in live]
        stopped = [name for name, ok in zip(live, results) if ok]
        print("Stopped %d of %d: %s" % (len(stopped), len(live), ", ".join(stopped) or "none"))
        if len(stopped) != len(live):
            fail("not every guest stopped. Nothing else was touched.")

    if not stop_watches(args.grace):
        fail("a temperature watch did not stop. Nothing else was touched.")

    if not args.DELETE:
        print("Every guest and its disk stays in place. A start needs no create.")
        return 0

    names = [g for g, _, _ in guests()]
    if not names:
        print("No guests on disk, nothing for --DELETE to remove.")
        return 0

    if not confirm_delete_all(names):
        print("Wrong answer. Nothing was deleted.")
        return 1

    failed = []
    for name in names:
        # Quiet, for the same reason cmd_delete is: avdmanager ends its own
        # line without a newline, and the summary below says the same thing.
        if run_tool([AVDMANAGER, "delete", "avd", "-n", name], quiet=True) != 0 \
                or guest_folder(name).exists():
            failed.append(name)
    if failed:
        fail("%d of %d guests were not removed: %s"
             % (len(failed), len(names), ", ".join(failed)))

    # The logs stay, for the same reason cmd_delete keeps them: cheap, and the
    # record of what ran here does not depend on the guest still existing.
    print("Removed %d guest(s): %s. Their folders under logs/ were left in place."
          % (len(names), ", ".join(names)))
    return 0


def cmd_status(args):
    rows = guests()
    if args.name:
        wanted = resolve(args.name)
        rows = [r for r in rows if r[0] == wanted]
    if not rows and not args.json:
        print("No guests on disk. Create one with: abgal create <template>")
        return 0

    states = attached()
    by_name = {}
    for serial, state in states.items():
        if state == "unauthorized":
            # The serial is known but the console refused the token, so the
            # guest behind it cannot be asked for its name. It is listed
            # below under its serial, because ignoring it would hide a guest
            # that is holding a port.
            continue
        found = serial_name(serial)
        if found:
            by_name[found] = (serial, state)

    free = available_mb()

    if args.json:
        guest_rows = []
        for name, template, number in rows:
            pid = running_pid(name)
            serial, state = by_name.get(name, (None, None))
            if pid is not None and serial is None:
                state = "not visible"
            cores = read_ini(guest_folder(name) / "config.ini").get("hw.cpu.ncore")
            guest_rows.append({
                "name": name, "id": number, "template": template,
                "pid": pid, "serial": serial, "adb": state, "cores": cores,
                "stats": process_stats(pid) if pid is not None else None,
            })
        print(json.dumps({"free_mb": free, "guests": guest_rows}))
        return 0

    layout = "%-22s %-9s %-9s %-14s %-12s %-6s %-6s %-6s %-9s %s"
    print(layout % ("NAME", "ID", "STATE", "DEVICE", "ADB", "MEM", "CPU", "CORES", "UPTIME", "TEMPLATE"))
    for name, template, number in rows:
        pid = running_pid(name)
        serial, state = by_name.get(name, (None, None))
        running = "stopped" if pid is None else "live"
        if pid is not None and serial is None:
            state = "not visible"
        cores = read_ini(guest_folder(name) / "config.ini").get("hw.cpu.ncore", "-")
        stats = process_stats(pid) if pid is not None else None
        mem = "%d" % stats["mem_mb"] if stats else "-"
        cpu = "%.1f" % stats["cpu_percent"] if stats else "-"
        uptime = format_uptime(stats["uptime_s"]) if stats else "-"
        print(layout % (name, number, running, serial or "-", state or "-",
                        mem, cpu, cores, uptime, template))

    unclaimed = [s for s, v in states.items() if v == "unauthorized"]
    if unclaimed:
        print()
        print("Unauthorized, name not readable: " + ", ".join(sorted(unclaimed)))

    if free is not None:
        print()
        print("Memory available: %d MB. A guest needs its own size plus about %d MB."
              % (free, OVERHEAD_MB))
    return 0


# --------------------------------------------------------------------- watch


# A decision from 2026-09-20, not the manufacturer's values: the chip reports
# high 84 C and crit 100 C. Idle already reached 86 C without one throttle
# event, and the abort has to come before the hardware acts. See finding B14.
TEMP_WARN = 88
TEMP_STOP = 96

# How long start gives a new watch before asking whether it is still alive.
WATCH_SETTLE = 2

# What start_one returns when its guest runs but its watch does not.
WATCH_DIED = 3


def env_number(name, default):
    raw = os.environ.get(name, "")
    if not raw:
        return default
    # isdigit alone also takes a superscript two, which int() then refuses
    # with a traceback.
    if not (raw.isascii() and raw.isdigit()):
        fail("%s=%s is not a whole number." % (name, raw))
    return int(raw)


def watch_settings():
    """Warning, stop, interval, grace and warmup, from the environment.

    start reads them too, before any guest runs, because a detached watch that
    fails on a bad value has nowhere to say so. See #34.
    """
    # A case without a screen gains ten degrees in fifteen seconds, so a
    # threshold only works with sampling this fast.
    return (env_number("ABGAL_TEMP_WARN", TEMP_WARN),
            env_number("ABGAL_TEMP_STOP", TEMP_STOP),
            env_number("ABGAL_TEMP_INTERVAL", 2),
            env_number("ABGAL_TEMP_GRACE", GRACE_SECONDS),
            env_number("ABGAL_TEMP_WARMUP", 120))


def thermal_zone():
    """The x86_pkg_temp zone, found by its type file.

    A glob over all zones would also match acpitz, which gives no usable
    value on this hardware.
    """
    for zone in sorted(Path("/sys/class/thermal").glob("thermal_zone*")):
        try:
            if (zone / "type").read_text().strip() == "x86_pkg_temp":
                return zone / "temp"
        except OSError:
            continue
    return None


def temperature(zone):
    """The package temperature in whole degrees, or None.

    The file first, sensors second. Both were checked against each other on
    2026-09-20 and agree except for rounding.
    """
    if zone:
        try:
            value = int(zone.read_text().strip()) // 1000
            if value:
                return value
        except (OSError, ValueError):
            pass
    try:
        out = subprocess.run(["sensors"], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in out.splitlines():
        if line.startswith("Package id 0"):
            digits = re.match(r"\+?(\d+)", line.split()[3])
            return int(digits.group(1)) if digits else None
    return None


def watched(name):
    """The guests being watched right now, by name."""
    found = []
    for _, args in qemu_processes():
        guest = args[args.index("-avd") + 1] if "-avd" in args[:-1] else None
        if guest and (name is None or guest == name):
            found.append(guest)
    return found


def stop_watched_guests(guest_names, grace, say):
    """Stops every guest the watch just aborted for, one signal chain each."""
    serials = running_serials()
    for guest in guest_names:
        stop_one(guest, serials.get(guest), grace, say=say)


def cmd_watch(args):
    # Without a name every guest is watched. With one, only that guest is
    # stopped: a hot package concerns the whole socket, but one watch must not
    # clear out every run on the machine.
    name = resolve(args.name) if args.name else None
    warn, stop, interval, grace, warmup = watch_settings()

    # One log per guest, so the lines of several runs do not interleave. The
    # run before is kept as .1, which answers whether it was already hot.
    default = LOGS / name / "watch.log" if name else LOGS / "watch.log"
    log = Path(os.environ.get("ABGAL_TEMP_LOG") or default)
    log.parent.mkdir(parents=True, exist_ok=True)
    if log.exists():
        log.replace(log.with_name(log.name + ".1"))

    def note(text):
        line = "%s  %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), text)
        print(line)
        with log.open("a") as out:
            out.write(line + "\n")

    zone = thermal_zone()
    note("Watch on. Warning from %d C, abort from %d C, every %d s.%s"
         % (warn, stop, interval, " Guest: %s." % name if name else ""))
    if zone is None:
        note("Note: no x86_pkg_temp zone found, only sensors counts.")
    if temperature(zone) is None:
        note("WATCH ABORTED: no temperature measurable. Neither sensors nor x86_pkg_temp.")
        return 2

    # Started next to the emulator, the watch may be quicker than qemu.
    waited = 0
    while not watched(name):
        if waited >= warmup:
            note("After %d s no emulator has appeared. Watch off." % waited)
            return 0
        time.sleep(5)
        waited += 5

    warned, highest, blind = False, 0, 0
    while True:
        guests_now = watched(name)
        if not guests_now:
            note("No emulator left. Watch off. Highest value was %d C." % highest)
            return 0

        value = temperature(zone)
        # A watch that measures nothing and keeps running fakes safety.
        if value is None:
            blind += 1
            if blind >= 4:
                note("WATCH ABORTED: no temperature measurable four times in a row. "
                     "No longer watching.")
                return 2
            note("Warning: temperature not readable (%d of 4)." % blind)
            time.sleep(interval)
            continue
        blind = 0
        highest = max(highest, value)

        if value >= stop:
            note("ABORT at %d C, threshold %d. Stopping the emulator." % (value, stop))
            stop_watched_guests(guests_now, grace, note)
            note("Stopped. Highest value was %d C." % highest)
            return 1

        if value >= warn and not warned:
            note("WARNING at %d C, threshold %d. Run continues." % (value, warn))
            warned = True
        elif warned and value < warn - 3:
            # Three degrees below the threshold, or the message flaps.
            note("All clear at %d C." % value)
            warned = False
        time.sleep(interval)


# ------------------------------------------------------------- setup, doctor


VERSION_FIELDS = ("part", "minimum", "source", "sha1")

LICENSE_URL = "https://developer.android.com/studio/terms"


def version_rows():
    """Every line of versions.conf, as a dict of its four columns."""
    found = []
    try:
        text = (HOME / "versions.conf").read_text()
    except OSError:
        return found
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = [f.strip() for f in line.split("|")]
        fields += [""] * (len(VERSION_FIELDS) - len(fields))
        found.append(dict(zip(VERSION_FIELDS, fields)))
    return found


def revision(text):
    """A revision as numbers, so that 37.1.11 counts as newer than 37.1.9."""
    found = re.match(r"[0-9.]+", text or "")
    return tuple(int(n) for n in found.group(0).split(".") if n) if found else ()


def installed(part):
    """The revision of a part under sdk/, or None when it is not there."""
    return read_ini(SDK / part / "source.properties").get("Pkg.Revision")


def too_old(row):
    found = installed(row["part"])
    return found is not None and revision(found) < revision(row["minimum"])


def doctor_checks():
    """Every check as state, subject, detail and the command that fixes it.

    A state of "later" is not a problem: the system image is fetched by the
    first create that needs it.
    """
    checks = []

    machine = platform.machine()
    if sys.platform.startswith("linux") and machine == "x86_64":
        checks.append(("ok", "Linux on x86_64", "", ""))
    else:
        checks.append(("no", "Linux on x86_64", "%s on %s" % (platform.system(), machine),
                       "macOS and Windows are planned in issue #13"))

    kvm = Path("/dev/kvm")
    user = pwd.getpwuid(os.getuid())
    try:
        group = grp.getgrnam("kvm")
        granted = user.pw_name in group.gr_mem or user.pw_gid == group.gr_gid
    except KeyError:
        granted = False
    if not kvm.exists():
        checks.append(("missing", "/dev/kvm", "no hardware acceleration",
                       "switch on virtualization in the firmware, then load kvm_intel or kvm_amd"))
    elif os.access(kvm, os.R_OK | os.W_OK):
        checks.append(("ok", "/dev/kvm", "usable by this session", ""))
    elif granted:
        # The same gap start bridges with "sg kvm", so it is not a problem.
        checks.append(("ok", "/dev/kvm", "kvm group granted, start uses sg kvm until the next login", ""))
    else:
        checks.append(("missing", "/dev/kvm", "%s is not in the kvm group" % user.pw_name,
                       'sudo usermod -aG kvm "$USER"'))

    rows = version_rows()
    if not rows:
        checks.append(("missing", "versions.conf", "missing or empty", "git checkout versions.conf"))
    for row in rows:
        found = installed(row["part"])
        if found is None:
            checks.append(("missing", row["part"], "", "./abgal setup"))
        elif too_old(row):
            checks.append(("too old", row["part"], "%s, needs %s" % (found, row["minimum"]),
                           "move sdk/%s aside, then ./abgal setup" % row["part"]))
        else:
            checks.append(("ok", row["part"], found, ""))

    templates_found = template_rows()
    seen = set()
    for row in templates_found:
        if row["image"] in seen:
            continue
        seen.add(row["image"])
        folder = SDK / "system-images" / ("android-" + row["api"]) / row["tag"] / row["abi"]
        found = installed(folder.relative_to(SDK))
        if found is None:
            checks.append(("later", row["image"], "the first create fetches it", ""))
        else:
            checks.append(("ok", row["image"], found, ""))

    runner_rows = [row for row in runner_version_rows() if row["arch"] == runner_arch()]
    if runner_rows:
        pinned = runner_rows[-1]["version"]
        latest = latest_runner_release()
        if latest is None:
            checks.append(("ok", "GitHub Actions runner", "%s pinned, could not reach GitHub to compare" % pinned, ""))
        elif latest == pinned:
            checks.append(("ok", "GitHub Actions runner", "%s, the newest release" % pinned, ""))
        else:
            checks.append(("later", "GitHub Actions runner", "%s pinned, %s is out" % (pinned, latest),
                           "test it on a branch first, see the comment atop runner-versions.conf"))

    free = available_mb()
    sizes = [memory_mb(row["ram"]) for row in templates_found if memory_mb(row["ram"])]
    if free is None:
        checks.append(("missing", "memory", "MemAvailable is not in /proc/meminfo", ""))
    elif sizes:
        need = min(sizes) + OVERHEAD_MB + RESERVE_MB
        detail = "%d MB free, the smallest guest needs %d MB" % (free, need)
        if free >= need:
            checks.append(("ok", "memory", detail, ""))
        else:
            checks.append(("too low", "memory", detail, "stop a guest, or close programs"))
    return checks


def cmd_doctor(args):
    print("Checking %s against versions.conf and devices.conf:" % HOME)
    checks = doctor_checks()
    width = max(len(c[1]) for c in checks)
    for state, subject, detail, fix in checks:
        print(("  %-8s %-*s  %s" % (state, width, subject, detail)).rstrip())
        if fix:
            print("  %-8s fix: %s" % ("", fix))
    bad = [c for c in checks if c[0] not in ("ok", "later")]
    print()
    if bad:
        print("%d of %d checks need attention." % (len(bad), len(checks)))
        return 1
    print("Ready. Create a guest with: ./abgal create <template>")
    return 0


def accept_license(parts):
    """Asks once for the license every part of the SDK comes under."""
    print("The Android SDK comes under the Android Software Development Kit License\n"
          "Agreement: %s\n\n"
          "Fetched under it: %s.\n"
          "The Android CLI accepts the same license for every part it installs,\n"
          "now and in a later create. On first use it puts itself, about 250 MB\n"
          "with its own Java runtime, into android-home/.\n" % (LICENSE_URL, ", ".join(parts)))
    if not sys.stdin.isatty():
        fail("nothing fetched, there is nobody to ask.\n"
             "       Read the license, then run: ./abgal setup --accept-licenses")
    try:
        answer = input("Accept it? [y/N] ")
    except EOFError:
        answer = ""
    return answer.strip().lower() in ("y", "yes")


def fetch_zip(row):
    """Fetches a zip named in versions.conf, checks it and unpacks it into sdk/.

    The download and the unpacked folder sit next to the target and only take
    its name at the end, so an interrupted setup leaves no half part behind.
    """
    target = SDK / row["part"]
    target.parent.mkdir(parents=True, exist_ok=True)
    download = target.parent / ".abgal-download.zip"
    unpack = target.parent / ".abgal-unpack"
    print("Fetching %s" % row["source"])
    digest = hashlib.sha1()
    try:
        with urllib.request.urlopen(row["source"], timeout=60) as response, \
                open(download, "wb") as out:
            total = int(response.headers.get("Content-Length") or 0)
            done, shown = 0, 0
            while True:
                chunk = response.read(1 << 20)
                if not chunk:
                    break
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                if total and done * 10 // total > shown:
                    shown = done * 10 // total
                    print("  %3d%%  %d MB" % (shown * 10, done >> 20))
    except (OSError, ValueError) as error:
        download.unlink(missing_ok=True)
        problem("could not fetch %s:\n       %s" % (row["source"], error))
        return False
    if digest.hexdigest() != row["sha1"]:
        download.unlink()
        problem("the download has sha1 %s, versions.conf expects %s.\n"
                "       Nothing was unpacked." % (digest.hexdigest(), row["sha1"]))
        return False

    shutil.rmtree(unpack, ignore_errors=True)
    try:
        with zipfile.ZipFile(download) as archive:
            for info in archive.infolist():
                path = archive.extract(info, unpack)
                # zipfile drops the permission bits, and adb without its x bit
                # is a file that cannot run.
                mode = info.external_attr >> 16 & 0o777
                if mode:
                    os.chmod(path, mode)
        inner = list(unpack.iterdir())
        (inner[0] if len(inner) == 1 and inner[0].is_dir() else unpack).rename(target)
    except (OSError, zipfile.BadZipFile) as error:
        problem("could not unpack into sdk/%s:\n       %s\n"
                "       If the folder exists without source.properties, move it aside."
                % (row["part"], error))
        return False
    finally:
        shutil.rmtree(unpack, ignore_errors=True)
        download.unlink(missing_ok=True)
    print("Unpacked into sdk/%s" % row["part"])
    return True


def cmd_setup(args):
    rows = version_rows()
    if not rows:
        fail("versions.conf is missing or empty, so there is nothing to fetch.")

    # A folder setup did not make may hold somebody's work, so an old one is
    # named and left for its owner to move.
    for row in rows:
        if too_old(row):
            fail("sdk/%s has %s, and AbGal needs %s or newer.\n"
                 "       Move the folder aside and run setup again."
                 % (row["part"], installed(row["part"]), row["minimum"]))

    missing = [row for row in rows if installed(row["part"]) is None]
    if not missing:
        print("Every part in versions.conf is already in sdk/.")
    else:
        if not args.accept_licenses and not accept_license([r["part"] for r in missing]):
            fail("nothing fetched, the license was not accepted.")
        for row in missing:
            if row["source"] != "android" and not fetch_zip(row):
                return 1
        packages = [row["part"] for row in missing if row["source"] == "android"]
        if packages:
            if not ANDROID_CLI.is_file():
                fail("%s is missing, so %s cannot be installed."
                     % (ANDROID_CLI, ", ".join(packages)))
            print("Installing %s, which takes a few minutes:" % ", ".join(packages))
            command = [ANDROID_CLI, "--no-metrics", "--sdk=%s" % SDK, "sdk", "install"]
            run_tool(command + packages, quiet=True)
            # The CLI ends with 0 even for a package it does not know, so
            # only the folder counts.
            lost = [p for p in packages if installed(p) is None]
            if lost:
                fail("the Android CLI did not install %s." % ", ".join(lost))
    # The exit code says whether fetching worked. What doctor finds, such as
    # a CI runner without /dev/kvm, is shown but does not fail setup.
    print()
    cmd_doctor(args)
    return 0


# --------------------------------------------------------------------- webui


VIEW_SERVICE = HOME / "view" / "view-service.py"
LOOPBACK = ("127.0.0.1", "::1", "localhost")


def webui_command(args):
    """The command line for view-service.py. Options not given are left out,
    so the service keeps its own defaults for them."""
    command = [sys.executable, str(VIEW_SERVICE), "--address", args.address]
    if args.port is not None:
        command += ["--port", str(args.port)]
    if args.guest:
        command += ["--guest", args.guest]
    for name in args.allow_host:
        command += ["--allow-host", name]
    return command


def cmd_webui(args):
    if not VIEW_SERVICE.is_file():
        fail("%s is missing." % VIEW_SERVICE)
    # The token is no login and the traffic is plain HTTP, see
    # docs/view-service.md. Said at every start, since the default is open.
    if args.address not in LOOPBACK:
        print("warning: listening on %s. Anyone who can reach this address can\n"
              "         start, stop and control every guest. Pass --address 127.0.0.1\n"
              "         to keep it on this machine." % args.address)
    try:
        return subprocess.run(webui_command(args)).returncode
    except KeyboardInterrupt:
        # The service got the same Ctrl-C and has printed that it stopped.
        return 0



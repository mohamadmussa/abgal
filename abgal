  abgal shutdown
  abgal webui
  abgal webui --address 127.0.0.1 --port 8100
  abgal github-runner status
  abgal github-runner status -n ci-01 --wait 60
  abgal github-runner log -n ci-01
"""


def build_parser():
    parser = argparse.ArgumentParser(
        prog="abgal",
        description="Android guests on this machine, created and run in batches.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subs = parser.add_subparsers(dest="command")

    setup = subs.add_parser("setup", help="fetch the SDK parts in versions.conf into sdk/")
    setup.add_argument("--accept-licenses", action="store_true",
                       help="accept the Android SDK license without being asked, for CI")
    setup.set_defaults(run=cmd_setup)

    doctor = subs.add_parser("doctor", help="check the machine and the SDK, say what to fix")
    doctor.set_defaults(run=cmd_doctor)

    listing = subs.add_parser("list", help="show the templates and the guests")
    listing.set_defaults(run=cmd_list)

    create = subs.add_parser("create", help="create guests from a template")
    create.add_argument("template", nargs="?",
                        help="a template name from devices.conf. Without it,"
                             " the templates are listed")
    create.add_argument("--as", dest="after", metavar="NAME",
                        help="name the guests after this instead of the template")
    create.add_argument("--count", type=int, default=1, metavar="N",
                        help="create N guests, numbered from 01")
    create.add_argument("--recreate", action="store_true",
                        help="delete an existing guest of that name first")
    create.add_argument("--yes", action="store_true",
                        help="with --recreate, do not ask first")
    create.set_defaults(run=cmd_create, parser=create)

    delete = subs.add_parser("delete", help="delete one guest and its disk")
    delete.add_argument("-n", "--name", required=True, metavar="GUEST",
                        help="the guest to delete, by name or by id")
    delete.add_argument("--yes", action="store_true", help="do not ask first")
    delete.add_argument("--force", action="store_true",
                        help="stop the guest first if it is still running")
    delete.add_argument("--grace", type=int, default=GRACE_SECONDS,
                        metavar="SECONDS",
                        help="how long --force waits for an orderly shutdown")
    delete.set_defaults(run=cmd_delete)

    start = subs.add_parser("start", help="start guests, one after another")
    start.add_argument("-n", "--name", metavar="GUEST", action="append",
                       help="a guest to start, by name or by id. Repeatable")
    start.add_argument("--port", type=int,
                       help="a fixed port. Without it the emulator picks one")
    start.add_argument("--gpu", default=os.environ.get("ABGAL_GPU", "software"),
                       help="graphics backend, software or host")
    start.add_argument("--locale", default=os.environ.get("ABGAL_LOCALE", "en-US"),
                       help="system language of the guest")
    start.add_argument("--timezone", default="Europe/Berlin")
    start.add_argument("--wipe", action="store_true",
                       help="wipe user data, so the guest boots as if it were new")
    start.add_argument("--force", action="store_true",
                       help="start even when memory looks too tight")
    start.add_argument("--no-watch", action="store_true",
                       help="do not start the temperature watch")
    start.add_argument("--no-wait", action="store_true",
                       help="return as soon as the console answers")
    start.add_argument("--timeout", type=int, default=300, metavar="SECONDS")
    start.add_argument("--dry-run", action="store_true",
                       help="show the command line and the checks, start nothing")
    start.set_defaults(run=cmd_start, parser=start)

    stop = subs.add_parser("stop", help="stop guests, one after another")
    stop.add_argument("-n", "--name", metavar="GUEST", action="append",
                      help="a guest to stop, by name or by id. Repeatable")
    stop.add_argument("--grace", type=int, default=GRACE_SECONDS, metavar="SECONDS",
                      help="how long to wait for an orderly shutdown")
    stop.set_defaults(run=cmd_stop, parser=stop)

    shutdown = subs.add_parser(
        "shutdown", help="stop every guest and its temperature watch, disks stay")
    shutdown.add_argument("--grace", type=int, default=GRACE_SECONDS, metavar="SECONDS",
                          help="how long to wait for an orderly shutdown")
    shutdown.add_argument("--DELETE", action="store_true",
                          help="after stopping, also delete every guest and its disk."
                               " Asks for a typed confirmation first")
    shutdown.set_defaults(run=cmd_shutdown)

    status = subs.add_parser("status", help="what is on disk and what is running")
    status.add_argument("-n", "--name", metavar="GUEST",
                        help="only this guest, by name or by id")
    status.add_argument("--json", action="store_true",
                        help="machine readable, with per guest memory and CPU")
    status.set_defaults(run=cmd_status)

    watch = subs.add_parser("watch", help="stop guests before the processor runs too hot")
    watch.add_argument("-n", "--name", metavar="GUEST",
                       help="only this guest, by name or by id. Without it, every guest")
    watch.set_defaults(run=cmd_watch)

    webui = subs.add_parser("webui", help="start the browser view, reachable from the network")
    webui.add_argument("--address", default="0.0.0.0",
                       help="the interface to listen on. 127.0.0.1 keeps it on this machine")
    webui.add_argument("--port", type=int,
                       help="the port. Without it the view service picks its own, 8099")
    webui.add_argument("--guest", metavar="GUEST",
                       help="a running guest to show first")
    webui.add_argument("--allow-host", action="append", default=[], metavar="NAME",
                       help="a host name the page may be opened under. Repeatable")
    webui.set_defaults(run=cmd_webui)

    runner = subs.add_parser(
        "github-runner", help="self hosted GitHub Actions runners, host or container")
    runner.set_defaults(run=lambda a: runner.print_help() or 0)
    runner_subs = runner.add_subparsers(dest="runner_command")

    runner_status = runner_subs.add_parser(
        "status", help="local liveness of one runner or every runner")
    runner_status.add_argument("-n", "--name", metavar="RUNNER",
                               help="only this runner. Without it, every runner")
    runner_status.add_argument("--wait", type=int, default=0, metavar="SECONDS",
                               help="repeat the check for this long, useful right after create")
    runner_status.set_defaults(run=cmd_github_runner_status)

    runner_log = runner_subs.add_parser(
        "log", help="the runner's own log, enough to see a successful connection")
    runner_log.add_argument("-n", "--name", required=True, metavar="RUNNER")
    runner_log.add_argument("--lines", type=int, default=200, metavar="N",
                            help="how many lines from the end of the log")
    runner_log.set_defaults(run=cmd_github_runner_log)

    runner_create = runner_subs.add_parser(
        "create", help="register and start a runner from runner.conf")
    runner_create.add_argument("-n", "--name", required=True, metavar="RUNNER",
                               help="the runner's name, also its entry in runner.conf")
    runner_create.add_argument("--repo", metavar="OWNER/REPO",
                               help="overrides the repo column of runner.conf")
    runner_create.add_argument("--labels", metavar="LIST",
                               help="overrides the labels column of runner.conf")
    runner_create.add_argument("--backend", choices=["host", "container"],
                               help="overrides the backend column of runner.conf")
    runner_create.add_argument("--version", metavar="VERSION",
                               help="a tested version from runner-versions.conf."
                                    " Without it, the newest tested for this machine")
    runner_create.add_argument("--key", metavar="TOKEN",
                               help="a personal access token, instead of one from gh")
    runner_create.set_defaults(run=cmd_github_runner_create)

    runner_remove = runner_subs.add_parser(
        "remove", help="stop, deregister and delete one runner")
    runner_remove.add_argument("-n", "--name", required=True, metavar="RUNNER")
    runner_remove.add_argument("--repo", metavar="OWNER/REPO",
                               help="overrides the repo remembered in the state file")
    runner_remove.add_argument("--backend", choices=["host", "container"],
                               help="used only without a state file, when name alone cannot tell")
    runner_remove.add_argument("--key", metavar="TOKEN",
                               help="a personal access token, instead of one from gh")
    runner_remove.set_defaults(run=cmd_github_runner_remove)

    return parser


def main():
    # Into a pipe or a log file Python buffers by the block while the tools it
    # calls write straight through, so a start ends up in the file after the
    # line that reports it finished. A log whose order lies is worse than none.
    sys.stdout.reconfigure(line_buffering=True)

    parser = build_parser()
    args = parser.parse_args()
    if not getattr(args, "run", None):
        parser.print_help()
        return 0
    # "list" reads two text files, setup and doctor are what a fresh clone
    # runs first. Everything else talks to the SDK, and a missing SDK there is
    # worth saying plainly instead of letting adb fail with a path nobody
    # recognises.
    if args.command not in ("list", "setup", "doctor", "github-runner") and (
            not ADB.is_file() or not EMULATOR.is_file()):
        fail("the Android SDK is not under %s.\n"
             "       Both platform-tools/adb and emulator/emulator have to be there.\n"
             "       Run ./abgal setup to fetch them." % SDK)
    return args.run(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

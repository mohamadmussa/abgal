EXAMPLES = """examples:
  abgal setup
  abgal doctor
  abgal list
  abgal create phone-1080x2400-480-api35-x86_64 --as dev --count 10
  abgal start -n dev-01
  abgal start -n dev-01 -n dev-02 -n dev-03
  abgal start -n dev-01 --gpu host --locale ar-SA
  abgal status
